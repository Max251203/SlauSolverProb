<Window x:Class="Client.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Распределенное решение СЛАУ" Height="600" Width="800">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Подключение к серверу -->
        <GroupBox Header="Подключение к серверу" Grid.Row="0" Margin="0,0,0,10">
            <Grid Margin="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="100"/>
                </Grid.ColumnDefinitions>
                <Label Content="IP адрес:" Grid.Column="0"/>
                <TextBox x:Name="ServerIpTextBox" Text="127.0.0.1" Grid.Column="1" Margin="5,0"/>
                <Label Content="Порт:" Grid.Column="2"/>
                <TextBox x:Name="ServerPortTextBox" Text="11000" Grid.Column="3" Margin="5,0"/>
            </Grid>
        </GroupBox>

        <!-- Параметры задачи и управление данными -->
        <GroupBox Header="Исходные данные" Grid.Row="1" Margin="0,0,0,10">
            <Grid Margin="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Label Content="Размер матрицы:" Grid.Column="0"/>
                <TextBox x:Name="MatrixSizeTextBox" Grid.Column="1" Margin="5,0"/>
                <Button x:Name="GenerateMatrixButton" Content="Сгенерировать" 
                Width="100" Grid.Column="2" Margin="15,0,5,0" Click="GenerateMatrixButton_Click"/>
                <Button x:Name="LoadMatrixButton" Content="Загрузить" 
                Width="80" Grid.Column="3" Margin="5,0" Click="LoadMatrixButton_Click"/>
                <Button x:Name="SaveMatrixButton" Content="Сохранить" 
                Width="80" Grid.Column="4" Margin="5,0" Click="SaveMatrixButton_Click"/>
            </Grid>
        </GroupBox>

        <!-- TabControl для матрицы и результатов -->
        <TabControl Grid.Row="2" Margin="0,5">
            <TabItem Header="Исходные данные">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Панель навигации -->
                    <Grid Grid.Row="0" Margin="0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" Grid.Column="0">
                            <Label Content="Строки:"/>
                            <TextBox x:Name="StartRowTextBox" Width="50" Margin="5,0"/>
                            <Label Content="-"/>
                            <TextBox x:Name="EndRowTextBox" Width="50" Margin="5,0"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Grid.Column="1" Margin="15,0">
                            <Label Content="Столбцы:"/>
                            <TextBox x:Name="StartColTextBox" Width="50" Margin="5,0"/>
                            <Label Content="-"/>
                            <TextBox x:Name="EndColTextBox" Width="50" Margin="5,0"/>
                        </StackPanel>

                        <Button Content="Показать" Width="80" Grid.Column="2" 
                                Margin="10,0" Click="ShowRangeButton_Click"/>

                        <StackPanel Orientation="Horizontal" Grid.Column="3">
                            <Label Content="Всего:"/>
                            <Label x:Name="TotalRowsLabel" Content="0"/>
                            <Label Content="×"/>
                            <Label x:Name="TotalColsLabel" Content="0"/>
                        </StackPanel>
                    </Grid>

                    <!-- Переключатель режима отображения -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,5">
                        <RadioButton x:Name="MatrixRadioButton" 
                                   Content="Матрица коэффициентов" 
                                   IsChecked="True" 
                                   Margin="0,0,15,0"
                                   Checked="MatrixRadioButton_Checked"/>
                        <RadioButton x:Name="VectorRadioButton" 
                                   Content="Столбец свободных членов"
                                   Checked="VectorRadioButton_Checked"/>
                        <CheckBox x:Name="EditModeCheckBox" 
                                Content="Режим редактирования" 
                                Margin="15,0,0,0"
                                Checked="EditModeCheckBox_Checked"
                                Unchecked="EditModeCheckBox_Unchecked"/>
                    </StackPanel>

                    <!-- Таблица данных -->
                    <DataGrid x:Name="MatrixGrid" 
                            Grid.Row="2"
                            Margin="0,5,0,0"
                            AutoGenerateColumns="False"
                            CanUserAddRows="False"
                            VirtualizingPanel.IsVirtualizing="True"
                            VirtualizingPanel.VirtualizationMode="Recycling"
                            CellEditEnding="MatrixGrid_CellEditEnding">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="TextBlock.TextAlignment" Value="Right"/>
                                <Setter Property="Padding" Value="5,2"/>
                            </Style>
                        </DataGrid.CellStyle>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Результаты">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Блок с метриками и статистикой -->
                    <GroupBox Header="Метрики выполнения" Grid.Row="0" Margin="0,0,0,10">
                        <TextBox x:Name="MetricsTextBox" 
                             IsReadOnly="True"
                             TextWrapping="Wrap" 
                             Height="100"          
                             VerticalScrollBarVisibility="Auto"
                             Margin="5"/>
                    </GroupBox>

                    <!-- Блок с результатами решения -->
                    <GroupBox Header="Вектор решения" Grid.Row="1" Margin="0,0,0,5">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <!-- Важно оставить * здесь -->
                            </Grid.RowDefinitions>

                            <!-- Панель навигации -->
                            <Grid Grid.Row="0" Margin="5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Orientation="Horizontal" Grid.Column="0">
                                    <Label Content="Элементы:"/>
                                    <TextBox x:Name="StartSolutionIndexTextBox" Width="50" Margin="5,0"/>
                                    <Label Content="-"/>
                                    <TextBox x:Name="EndSolutionIndexTextBox" Width="50" Margin="5,0"/>
                                </StackPanel>

                                <Button Content="Показать" Width="80" Grid.Column="1" 
                                    Margin="10,0" Click="ShowSolutionRangeButton_Click"/>

                                <StackPanel Orientation="Horizontal" Grid.Column="2">
                                    <Label Content="Всего элементов:"/>
                                    <Label x:Name="TotalSolutionElementsLabel" Content="0"/>
                                </StackPanel>
                            </Grid>

                            <!-- Таблица с результатами -->
                            <DataGrid x:Name="SolutionGrid" 
                                 Grid.Row="1"
                                 Margin="5"
                                 AutoGenerateColumns="False"
                                 IsReadOnly="True"
                                 CanUserAddRows="False"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling">
                                 <DataGrid.Columns>
                                    <DataGridTextColumn Header="№" 
                                        Binding="{Binding Index}" 
                                        Width="Auto"/>
                                    <DataGridTextColumn Header="Линейное решение" 
                                        Binding="{Binding SequentialSolution, StringFormat=F6, TargetNullValue=''}" 
                                        Width="*"/>
                                    <DataGridTextColumn Header="Распределенное решение" 
                                        Binding="{Binding DistributedSolution, StringFormat=F6, TargetNullValue=''}" 
                                        Width="*"/>
                                    <DataGridTextColumn Header="Эталонное решение" 
                                        Binding="{Binding TrueSolution, StringFormat=F6, TargetNullValue=''}" 
                                        Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </GroupBox>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Нижняя панель -->
        <StackPanel Grid.Row="3" 
            Orientation="Horizontal" 
            HorizontalAlignment="Right" 
            Margin="0,5,0,0">
            <Button x:Name="TestButton" 
            Content="Протестировать" 
            Width="100" 
            Click="TestButton_Click" 
            Margin="0,0,10,0"/>
            <Button x:Name="SolveButton" 
            Content="Решить" 
            Width="100" 
            Click="SolveButton_Click"/>
        </StackPanel>
    </Grid>
</Window>